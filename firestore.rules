rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile documents: users can read and write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Patient records:
    // - Authenticated users can create and manage their patient record(s)
    // - Public read allowed for emergency QR code access and doctor scanning
    match /patients/{patientId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}


